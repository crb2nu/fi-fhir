{
  "name": "@fi-fhir/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for fi-fhir healthcare integration library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "fhir",
    "hl7",
    "healthcare",
    "hl7v2",
    "medical",
    "interoperability"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://gitlab.flexinfer.ai/libs/fi-fhir.git",
    "directory": "sdk/typescript"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {},
  "dependencies": {},
  "optionalDependencies": {
    "@fi-fhir/fi-fhir-darwin-arm64": "file:packages/fi-fhir-darwin-arm64",
    "@fi-fhir/fi-fhir-darwin-x64": "file:packages/fi-fhir-darwin-x64",
    "@fi-fhir/fi-fhir-linux-arm64": "file:packages/fi-fhir-linux-arm64",
    "@fi-fhir/fi-fhir-linux-x64": "file:packages/fi-fhir-linux-x64",
    "@fi-fhir/fi-fhir-win32-x64": "file:packages/fi-fhir-win32-x64"
  }
}
