# fi-fhir Full-Stack Environment Configuration
#
# This matches the k3s production deployment (fi-fhir-api.yaml) with
# sanitized secrets. Copy to .env and fill in real credentials.
#
# See also: .env.example (minimal), docs/developer-guide/development-setup.md

# ─── Database (PostgreSQL) ────────────────────────────────────
FI_FHIR_DATABASE_DRIVER=postgres
FI_FHIR_DATABASE_HOST=localhost
FI_FHIR_DATABASE_PORT=5432
FI_FHIR_DATABASE_NAME=fi_fhir
FI_FHIR_DATABASE_USERNAME=fi_fhir
FI_FHIR_DATABASE_PASSWORD=CHANGE_ME
FI_FHIR_DATABASE_SSL_MODE=disable

# ─── Server ───────────────────────────────────────────────────
FI_FHIR_SERVER_HOST=0.0.0.0
FI_FHIR_SERVER_PORT=8081

# ─── Workflow ─────────────────────────────────────────────────
FI_FHIR_WORKFLOW_CONFIG_PATH=./configs/adt-workflow.yaml

# ─── LLM ──────────────────────────────────────────────────────
# In production, this points to the local vLLM/Ollama endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_DEFAULT_MODEL=llama3.2
LLM_QUALITY_MODEL=llama3.2

# ─── Qdrant (vector search) ──────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── Embedding ────────────────────────────────────────────────
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ─── Temporal (workflow orchestration) ────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=terminology-mapping

# ─── Terminology ──────────────────────────────────────────────
FI_FHIR_TERMINOLOGY_DB_URL=postgres://fi_fhir:CHANGE_ME@localhost:5432/fi_fhir?sslmode=disable
FI_FHIR_TERMINOLOGY_PINS=SNOMED:20240901,LOINC:2.77
FI_FHIR_TERMINOLOGY_POLICY=warn

# ─── MinIO/S3 (terminology ETL) ──────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_USE_SSL=false
MINIO_BUCKET=terminology

# ─── UMLS API ────────────────────────────────────────────────
UMLS_API_KEY=CHANGE_ME

# ─── Observability ───────────────────────────────────────────
FI_FHIR_METRICS_ENABLED=true
FI_FHIR_METRICS_PORT=9090
FI_FHIR_LOG_LEVEL=info
FI_FHIR_LOG_FORMAT=json
FI_FHIR_TRACING_ENABLED=true
FI_FHIR_TRACING_ENDPOINT=http://localhost:4317
