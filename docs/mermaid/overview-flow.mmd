flowchart TB
  subgraph IN["Input formats"]
    HL7[HL7v2<br/>ADT / ORU / SIU]
    CSV[CSV / Flatfiles]
    X12[EDI X12<br/>837 / 835 / 270-271 / 276-277]
    CDA[CDA / CCDA]
    FHIR[FHIR R4]
  end

  subgraph CFG["Configuration (per feed)"]
    P[Source Profile<br/>YAML]
    W[Workflow Config<br/>YAML + CEL]
  end

  subgraph PARSE["Parse pipeline (3 phases)"]
    B[Phase 1<br/>Byte normalization]
    S[Phase 2<br/>Syntactic parse]
    E[Phase 3<br/>Semantic extraction]
    B --> S --> E
  end

  subgraph CANON["Canonical layer"]
    EV[Canonical events]
    WARN[Warnings<br/>recoverable anomalies]
  end

  subgraph FLOW["Workflow engine"]
    R[Routes + filters<br/>CEL]
    T[Transforms]
    A[Actions]
    R --> T --> A
  end

  subgraph OUT["Side effects"]
    OFHIR[FHIR API]
    WH[Webhook]
    DB[(Database)]
    MQ[(Queue)]
    LOG[Logs / metrics]
  end

  HL7 --> B
  CSV --> B
  X12 --> B
  CDA --> B
  FHIR --> B

  P -. configures .-> B
  P -. configures .-> E
  W -. configures .-> R

  E --> EV
  E --> WARN
  EV --> R

  A --> OFHIR
  A --> WH
  A --> DB
  A --> MQ
  A --> LOG
