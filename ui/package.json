{
  "name": "@flexinfer/fi-fhir-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "npm run sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run sync && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.svelte\"",
    "test": "vitest",
    "test:run": "npm run sync && vitest run",
    "test:coverage": "vitest run --coverage",
    "codegen:graphql": "node scripts/graphql-codegen.cjs --config codegen.yml",
    "codegen:openapi": "openapi-typescript ../api/openapi.yaml -o src/lib/gen/openapi.ts",
    "codegen": "npm run codegen:openapi && npm run codegen:graphql",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/lib/gen"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typed-document-node": "^5.0.12",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.4.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.14.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/types": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-plugin-svelte": "^3.2.0",
    "globals": "^15.14.0",
    "graphql": "^16.10.0",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.5.2",
    "postcss-html": "^1.8.0",
    "stylelint": "^16.14.1",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/lr": "^1.4.0",
    "graphql-ws": "^6.0.7",
    "js-yaml": "^4.1.1"
  },
  "overrides": {
    "lodash": "4.18.1"
  }
}
