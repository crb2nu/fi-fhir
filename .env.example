# fi-fhir Environment Configuration
# Copy this to .env and customize as needed
#
# These variable names match what config.LoadFromEnv() reads and
# what the k3s production deployment injects via fi-fhir-api.yaml.

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Required for persistent event/profile/workflow stores.
# When these are unset, fi-fhir serve falls back to in-memory stores.
FI_FHIR_DATABASE_DRIVER=postgres
FI_FHIR_DATABASE_HOST=localhost
FI_FHIR_DATABASE_PORT=5432
FI_FHIR_DATABASE_NAME=fi_fhir
FI_FHIR_DATABASE_USERNAME=fi_fhir
# FI_FHIR_DATABASE_USER=fi_fhir       # k8s compat alias (used when USERNAME is unset)
FI_FHIR_DATABASE_PASSWORD=fi_fhir_dev
FI_FHIR_DATABASE_SSL_MODE=disable
# Connection pool tuning.
# FI_FHIR_DATABASE_MAX_OPEN_CONNS=25
# FI_FHIR_DATABASE_MAX_IDLE_CONNS=5
# FI_FHIR_DATABASE_CONN_MAX_LIFETIME=5m
# The terminology ETL commands take a single DSN instead of the discrete
# settings above. Falls back to DATABASE_URL; one of the two is required.
# FI_FHIR_DATABASE_URL=postgres://fi_fhir:fi_fhir_dev@localhost:5432/fi_fhir?sslmode=disable

# ─── Server ────────────────────────────────────────────────────
FI_FHIR_SERVER_HOST=0.0.0.0
FI_FHIR_SERVER_PORT=8081
# FI_FHIR_SERVER_READ_TIMEOUT=30s
# FI_FHIR_SERVER_WRITE_TIMEOUT=30s
# FI_FHIR_SERVER_SHUTDOWN_TIMEOUT=10s
# Serve TLS directly instead of terminating upstream. Both must be set together.
# FI_FHIR_SERVER_TLS_CERT_FILE=/var/run/secrets/fi-fhir-server/tls.crt
# FI_FHIR_SERVER_TLS_KEY_FILE=/var/run/secrets/fi-fhir-server/tls.key

# ─── Authenticated integration preview ────────────────────────
# Required by `fi-fhir serve`. Static mode is a local/preview compatibility
# path. Use exactly one token source; the direct token is suitable only for
# local development.
FI_FHIR_DEPLOYMENT_TENANT_ID=tenant-a
FI_FHIR_GRAPHQL_AUTH_MODE=static
# Generate locally, for example: openssl rand -hex 32
FI_FHIR_GRAPHQL_BEARER_TOKEN=
# FI_FHIR_GRAPHQL_BEARER_TOKEN_FILE=/var/run/secrets/fi-fhir-graphql/bearer-token
FI_FHIR_GRAPHQL_PRINCIPAL_ID=local-operator
# Local full-IDE access. Production preview callers should keep only
# integration:preview; graphql:operator is the deprecated compatibility grant.
FI_FHIR_GRAPHQL_ROLES=integration:preview,graphql:operator
FI_FHIR_GRAPHQL_ALLOWED_ORIGINS=http://localhost:5173
FI_FHIR_INTEGRATION_REGISTRY_PATH=./testdata/golden/integration/adt-http/preview-registry.json
# Static mode only. Callers from these CIDRs are authenticated as the principal
# and roles above without presenting the bearer token. Unset disables it.
# FI_FHIR_GRAPHQL_TRUSTED_CIDRS=10.42.0.0/16,127.0.0.1/32

# OIDC mode verifies each human caller's JWT access token (`typ=at+jwt`)
# through issuer discovery and cached JWKS.
# When enabled, remove every static bearer/principal/roles/trusted-CIDR setting.
# FI_FHIR_GRAPHQL_AUTH_MODE=oidc
# FI_FHIR_GRAPHQL_OIDC_ISSUER_URL=https://identity.example.test
# FI_FHIR_GRAPHQL_OIDC_AUDIENCE=fi-fhir
# FI_FHIR_GRAPHQL_OIDC_TENANT_CLAIM=tenant_id
# FI_FHIR_GRAPHQL_OIDC_ROLES_CLAIM=roles
# FI_FHIR_GRAPHQL_OIDC_SIGNING_ALGS=RS256

# Cloudflare Access identity (either mode). When Cloudflare Access fronts the
# deployment, accept the signed assertion the edge attaches to each request and
# grant the listed roles to the listed email addresses. Set all three or none.
# The AUD tag is on the Access application's overview page.
# FI_FHIR_GRAPHQL_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# FI_FHIR_GRAPHQL_ACCESS_AUDIENCE=<application AUD tag>
# FI_FHIR_GRAPHQL_ACCESS_PRINCIPALS=operator@example.com=integration:preview,graphql:operator,clinical:read;analyst@example.com=integration:preview,clinical:read

# Restart-safe Integration Session workspace. Disabled by default. Enabling it
# requires PostgreSQL. Samples are redacted unless retention is requested
# explicitly; retained raw payloads additionally require a mounted 32-byte key.
# FI_FHIR_INTEGRATION_SESSION_ENABLED=true
# FI_FHIR_INTEGRATION_SESSION_RETENTION_KEY_FILE=/var/run/secrets/fi-fhir-session/aes-256-key
# Signed session publication. All three are required together: setting any one
# without the others is refused at startup. Leave all unset to publish unsigned.
# FI_FHIR_INTEGRATION_SESSION_SIGNING_KEY_FILE=/var/run/secrets/fi-fhir-session/signing-key.pem
# FI_FHIR_INTEGRATION_SESSION_TRUST_ROOT_FILE=/var/run/secrets/fi-fhir-session/trust-root.pem
# FI_FHIR_INTEGRATION_SESSION_SIGNING_KEY_ID=session-signing-1

# ─── PHI retention policy and purge (Slice 4.1e, optional) ─────
# Unset FI_FHIR_RETENTION_POLICY_PATH means NO purge component, no policy
# record, and nothing purged. That is deliberate: an unconfigured deployment
# must never destroy clinical data. A malformed document fails startup rather
# than starting a retention control that quietly never acts.
#
# The document is JSON. An omitted window means retain that class indefinitely.
# stream_event_retain may not be shorter than 24h — the schema enforces the same
# floor, because the fanout log is a subscriber's resume cursor.
#
#   {
#     "tenant_id": "tenant-a",
#     "canonical_event_retain": "8760h",
#     "session_sample_retain":  "720h",
#     "session_export_retain":  "2160h",
#     "stream_event_retain":    "168h",
#     "authorized_by": {"id": "privacy-officer-1", "kind": "human", "auth_method": "oidc"},
#     "reason": "HIPAA minimum-necessary retention approved 2026-08-08"
#   }
#
# A canonical event payload and an export snapshot are TOMBSTONED, not deleted;
# a session sample row is deleted outright. A tombstone is not a
# backup-inclusive deletion — see docs/operations/PHI-RETENTION.md section 2.
# FI_FHIR_RETENTION_POLICY_PATH=/etc/fi-fhir/retention-policy.json
# FI_FHIR_RETENTION_PURGE_INTERVAL=1h
# FI_FHIR_RETENTION_PURGE_BATCH_SIZE=200

# ─── Authenticated HL7v2 production ingress (optional) ─────────
# Leave AUTH_MODE unset to keep /v1/hl7v2 unmounted. Enabling it requires the
# PostgreSQL variables above. Bearer/HMAC modes require exactly one secret;
# oauth2 instead verifies an allowlisted client through HTTPS discovery/JWKS.
# FI_FHIR_HTTP_INGRESS_AUTH_MODE=bearer       # bearer, hmac-sha256, or oauth2
# FI_FHIR_HTTP_INGRESS_PRINCIPAL_ID=adt-service
# FI_FHIR_HTTP_INGRESS_INTEGRATION_ID=adt-east
# FI_FHIR_HTTP_INGRESS_SECRET=
# FI_FHIR_HTTP_INGRESS_SECRET_FILE=/var/run/secrets/fi-fhir-ingress/credential
# OAuth2 mode requires signed JWT access tokens with typ=at+jwt, sub equal to
# client_id, the deployment tenant, and integration:submit. Remove the static
# principal/secret settings when enabling it.
# FI_FHIR_HTTP_INGRESS_OAUTH_ISSUER_URL=https://identity.example.test
# FI_FHIR_HTTP_INGRESS_OAUTH_AUDIENCE=fi-fhir-ingress
# FI_FHIR_HTTP_INGRESS_OAUTH_TENANT_CLAIM=tenant_id
# FI_FHIR_HTTP_INGRESS_OAUTH_ROLES_CLAIM=roles
# FI_FHIR_HTTP_INGRESS_OAUTH_CLIENT_ID_CLAIM=client_id
# FI_FHIR_HTTP_INGRESS_OAUTH_SIGNING_ALGS=RS256
# FI_FHIR_HTTP_INGRESS_OAUTH_ALLOWED_CLIENT_IDS=svc-adt-east
# FI_FHIR_HTTP_INGRESS_MAX_BODY_BYTES=1048576

# ─── Deployed HL7v2 MLLP listener (optional) ──────────────────
# Leave SOURCE_CONFIG_PATH unset to disable the listener. Production should use
# the mutual-TLS source fixture and file-mounted key/certificate material.
# FI_FHIR_MLLP_SOURCE_CONFIG_PATH=./testdata/golden/integration/adt-mllp/source-revision.json
# FI_FHIR_MLLP_DEFINITION_ID=integration-mllp
# FI_FHIR_MLLP_PRINCIPAL_ID=mllp-listener
# Fail closed unless the source revision declares clients.identities
# (verified client-certificate URI SAN / SPKI service identity mapping).
# FI_FHIR_MLLP_REQUIRE_CLIENT_IDENTITY=true
# FI_FHIR_MLLP_TLS_CERT_FILE=/var/run/secrets/fi-fhir-mllp/tls.crt
# FI_FHIR_MLLP_TLS_KEY_FILE=/var/run/secrets/fi-fhir-mllp/tls.key
# FI_FHIR_MLLP_TLS_CLIENT_CA_FILE=/var/run/secrets/fi-fhir-mllp/client-ca.crt

# ─── Deployed S3/SFTP batch source (optional) ────────────────
# Leave SOURCE_CONFIG_PATH unset to disable polling. The immutable source file
# selects exactly one provider. PostgreSQL stores raw-free leases/checkpoints.
# FI_FHIR_BATCH_SOURCE_CONFIG_PATH=./testdata/golden/integration/adt-batch-s3/source-revision.json
# FI_FHIR_BATCH_DEFINITION_ID=integration-batch
# FI_FHIR_BATCH_PRINCIPAL_ID=batch-ingest
# Fail closed unless the source revision declares a workload block
# (canonical service subject plus its submit grants).
# FI_FHIR_BATCH_REQUIRE_WORKLOAD_IDENTITY=true
# Optional. Unset derives <hostname>-<pid>, the same scheme the delivery
# worker has always used. Every replica MUST have a distinct worker ID: the
# checkpoint store treats a *matching* ID as a lease renewal, so replicas
# that share one ID steal each other's live leases and process the same
# object concurrently. Leaving this unset is the recommended way to get a
# unique ID; do not set the same value on more than one replica.
# FI_FHIR_BATCH_WORKER_ID=
# S3 source credentials; production should use file-backed values and TLS.
# FI_FHIR_BATCH_S3_ACCESS_KEY=
# FI_FHIR_BATCH_S3_ACCESS_KEY_FILE=/var/run/secrets/fi-fhir-batch/s3-access-key
# FI_FHIR_BATCH_S3_SECRET_KEY=
# FI_FHIR_BATCH_S3_SECRET_KEY_FILE=/var/run/secrets/fi-fhir-batch/s3-secret-key
# SFTP sources require a pinned known_hosts file and exactly one auth mode.
# FI_FHIR_BATCH_SFTP_KNOWN_HOSTS_FILE=/var/run/secrets/fi-fhir-batch/known_hosts
# FI_FHIR_BATCH_SFTP_PASSWORD=
# FI_FHIR_BATCH_SFTP_PASSWORD_FILE=/var/run/secrets/fi-fhir-batch/sftp-password
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_FILE=/var/run/secrets/fi-fhir-batch/id_ed25519
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_PASSPHRASE=
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_PASSPHRASE_FILE=/var/run/secrets/fi-fhir-batch/key-passphrase

# ─── Durable Kafka delivery worker (optional) ─────────────────
# Leave WORKER_ENABLED unset/false to preserve pending outbox rows without
# publishing. Kafka credentials are rejected unless TLS is enabled.
# FI_FHIR_DELIVERY_WORKER_ENABLED=true
# FI_FHIR_DELIVERY_WORKER_ID=fi-fhir-local-1
# FI_FHIR_QUEUE_DRIVER=kafka
# FI_FHIR_QUEUE_BROKERS=localhost:9092
# FI_FHIR_QUEUE_CLIENT_ID=fi-fhir-delivery
# FI_FHIR_QUEUE_TLS=false
# FI_FHIR_QUEUE_TLS_ROOT_CA_FILE=/var/run/secrets/fi-fhir-kafka/ca.crt
# FI_FHIR_QUEUE_USERNAME=
# FI_FHIR_QUEUE_PASSWORD=
# FI_FHIR_QUEUE_PASSWORD_FILE=/var/run/secrets/fi-fhir-kafka/password
# FI_FHIR_DELIVERY_LEASE_DURATION=30s
# FI_FHIR_DELIVERY_POLL_INTERVAL=250ms
# FI_FHIR_DELIVERY_PUBLISH_TIMEOUT=10s
# FI_FHIR_DELIVERY_MAX_ATTEMPTS=5
# FI_FHIR_DELIVERY_RETRY_BASE_DELAY=1s
# FI_FHIR_DELIVERY_RETRY_MAX_DELAY=1m
# FI_FHIR_DELIVERY_CIRCUIT_FAILURE_THRESHOLD=3
# FI_FHIR_DELIVERY_CIRCUIT_OPEN_DURATION=30s

# ─── Destination-scoped delivery identity (Slices 4.1c-a / 4.1c-b) ──────
# Adds one fail-closed integration.deliver decision to the durable dispatch
# path, evaluated after the outbox row is claimed and before any destination or
# broker is contacted. Leave MODE unset to run without the decision; setting any
# other FI_FHIR_DELIVERY_IDENTITY_* variable without MODE is refused at startup.
#
# Since Slice 4.1c-b the destination revision's `transport` field decides how a
# claimed attempt leaves this process:
#   kafka  one command to integration.delivery.v1; the engine contacts nothing.
#   https  the engine contacts the destination itself over TLS, once per claimed
#          attempt, under the credential the revision's token_binding names.
# UPGRADE NOTE: a destination already declaring transport: https starts
# receiving real traffic on upgrade. The field was inert before 4.1c-b.
#
# The HTTPS call reuses FI_FHIR_DELIVERY_PUBLISH_TIMEOUT above; there is no
# separate timeout, because that setting is already required to be shorter than
# the lease and a second knob would be a second way to break that.
#
# The delivery worker still requires FI_FHIR_QUEUE_DRIVER=kafka and
# FI_FHIR_QUEUE_BROKERS even when every destination in the registry declares
# transport: https, so an HTTPS-only deployment stands up a broker it never
# produces to. This is deliberate: the registry is one file read at boot, so
# "all destinations are https" is a property of one startup rather than of the
# deployment, and relaxing it would turn adding one kafka-class destination
# from a startup error into a runtime dead letter. See .loom/40-decisions.md
# (2026-08-09).
#
# strict        every destination in the registry must declare a client
#               identity, and a compatibility subject is refused.
# compatibility unbound destinations are authorized under one explicit,
#               server-issued grant; a subject is required.
# The two modes reject each other's configuration.
#
# The registry is a server-owned document: a tenant, the integration revision
# its destinations belong to, the deployment's secret bindings (names and
# references only, never values), and the content-addressed destination
# revisions. Every declared binding is resolved once at startup and discarded,
# so a missing credential refuses startup rather than failing at dispatch.
#
# For https destinations the token and CA bundle bindings are also resolved once
# per dispatch and zeroed immediately. There is no cache: file and env
# references cannot be version-pinned, so rotation is a write in place that
# takes effect on the next dispatch with no restart. Write atomically.
# FI_FHIR_DELIVERY_IDENTITY_MODE=strict
# FI_FHIR_DELIVERY_IDENTITY_REGISTRY_PATH=/app/config/destination-registry.json
# FI_FHIR_DELIVERY_IDENTITY_SECRET_DIR=/var/run/secrets/fi-fhir-destinations
# FI_FHIR_DELIVERY_IDENTITY_COMPATIBILITY_SUBJECT=

# ─── Workflow ──────────────────────────────────────────────────
# FI_FHIR_WORKFLOW_CONFIG_PATH=./configs/adt-workflow.yaml
# Dry run evaluates rules and logs the actions it would take without
# executing any of them.
# FI_FHIR_WORKFLOW_DRY_RUN=false
# FI_FHIR_WORKFLOW_MAX_CONCURRENCY=10
# FI_FHIR_WORKFLOW_ACTION_TIMEOUT=30s
# FI_FHIR_WORKFLOW_RETRY_MAX_ATTEMPTS=3
# FI_FHIR_WORKFLOW_RETRY_INITIAL_WAIT=1s
# FI_FHIR_WORKFLOW_RETRY_MAX_WAIT=30s
# Events that exhaust their retries land in the dead letter queue rather than
# being dropped. The queue is in-memory and bounded.
# FI_FHIR_WORKFLOW_DLQ_ENABLED=true
# FI_FHIR_WORKFLOW_DLQ_MAX_SIZE=10000

# ─── Outbound FHIR client (optional) ───────────────────────────
# Target server for actions that write FHIR resources. Leave BASE_URL unset to
# keep the client unconfigured. AUTH_TYPE selects which credential block below
# applies; ${secret:KEY} defers a value to FI_FHIR_SECRETS_PROVIDER.
# FI_FHIR_FHIR_BASE_URL=https://fhir.example.test/r4
# FI_FHIR_FHIR_TIMEOUT=30s
# FI_FHIR_FHIR_AUTH_TYPE=none                 # none, basic, bearer, or oauth2
# FI_FHIR_FHIR_USERNAME=
# FI_FHIR_FHIR_PASSWORD=
# FI_FHIR_FHIR_BEARER_TOKEN=
# FI_FHIR_FHIR_OAUTH2_TOKEN_URL=https://identity.example.test/oauth2/token
# FI_FHIR_FHIR_OAUTH2_CLIENT_ID=fi-fhir
# FI_FHIR_FHIR_OAUTH2_CLIENT_SECRET=

# ─── LLM (for AI-powered features) ────────────────────────────
# Every LLM feature is gated behind FI_FHIR_LLM_ENABLED. It is false by
# default, so the per-feature "true" defaults below take effect only once the
# top-level switch is on.
#
# Several of these accept an unprefixed fallback (FI_FHIR_LLM_BASE_URL, then
# LLM_BASE_URL). The prefixed name wins when both are set; the unprefixed form
# is noted inline where it exists. Values shown are the built-in defaults,
# which target the in-cluster LiteLLM/Qdrant services.
# FI_FHIR_LLM_ENABLED=false
# FI_FHIR_LLM_BASE_URL=http://litellm.ai.svc.cluster.local:8000/v1   # or LLM_BASE_URL
# FI_FHIR_LLM_API_KEY=                                               # or LLM_API_KEY
# FI_FHIR_LLM_DEFAULT_MODEL=qwen3-8b-fast                            # or LLM_DEFAULT_MODEL
# FI_FHIR_LLM_QUALITY_MODEL=qwen3-14b-quality                        # or LLM_QUALITY_MODEL
# FI_FHIR_LLM_TIMEOUT=30s
# FI_FHIR_LLM_MAX_RETRIES=3
#
# For a local Ollama instead of the cluster services:
# FI_FHIR_LLM_BASE_URL=http://localhost:11434/v1
# FI_FHIR_LLM_DEFAULT_MODEL=llama3.2
# FI_FHIR_LLM_QUALITY_MODEL=llama3.2
#
# Per-feature toggles. Each *_MODEL is unset by default and falls back to the
# default/quality model above.
# FI_FHIR_LLM_EXTRACTION_ENABLED=true
# FI_FHIR_LLM_EXTRACTION_MODEL=
# FI_FHIR_LLM_EXTRACTION_MIN_CONFIDENCE=0.7
# FI_FHIR_LLM_EXPLAIN_WARNINGS_ENABLED=true
# FI_FHIR_LLM_EXPLAIN_WARNINGS_MODEL=
# FI_FHIR_LLM_EXPLAIN_WARNINGS_BATCH_SIZE=10
# FI_FHIR_LLM_EXPLAIN_WARNINGS_CACHE_TTL=24h
# FI_FHIR_LLM_DATA_QUALITY_ENABLED=true
# FI_FHIR_LLM_DATA_QUALITY_MODEL=
# FI_FHIR_LLM_DATA_QUALITY_MIN_SCORE=0.6
# FI_FHIR_LLM_COPILOT_ENABLED=true
# FI_FHIR_LLM_COPILOT_MODEL=
# FI_FHIR_LLM_COPILOT_MAX_TOKENS=2048
# FI_FHIR_LLM_COPILOT_TEMPERATURE=0.2

# ─── Semantic terminology search (LLM feature) ────────────────
# Vector search over the terminology index. Indexing on startup is off by
# default because it re-embeds the corpus.
# FI_FHIR_LLM_SEMANTIC_ENABLED=true
# FI_FHIR_LLM_SEMANTIC_MIN_SCORE=0.7
# FI_FHIR_LLM_SEMANTIC_MAX_RESULTS=10
# FI_FHIR_LLM_INDEX_ON_STARTUP=false
# FI_FHIR_LLM_EMBEDDING_MODEL=bge-large-embeddings        # or LLM_EMBEDDING_MODEL
# FI_FHIR_LLM_EMBEDDING_DIMENSIONS=1024
# FI_FHIR_LLM_EMBEDDING_BASE_URL=                         # defaults to the LLM base URL
# FI_FHIR_LLM_EMBEDDING_API_KEY=
# Relevance feedback is recorded only when learning is enabled.
# FI_FHIR_LLM_FEEDBACK_LEARNING=false
# FI_FHIR_LLM_FEEDBACK_COLLECTION=fi_fhir_feedback

# ─── Qdrant (vector store) ────────────────────────────────────
# Two independent settings, not aliases. The FI_FHIR_LLM_QDRANT_* pair backs
# semantic terminology search in `serve`; the FI_FHIR_QDRANT_* pair is read by
# the `llm` CLI subcommands.
# FI_FHIR_LLM_QDRANT_URL=http://qdrant.ai.svc.cluster.local:6333
# FI_FHIR_LLM_QDRANT_API_KEY=
# FI_FHIR_QDRANT_URL=http://localhost:6333
# FI_FHIR_QDRANT_API_KEY=

# ─── Legacy unprefixed terminology settings ───────────────────
# Read directly (no FI_FHIR_ equivalent) by the terminology CLI and the
# semantic search package.
# QDRANT_URL=http://localhost:6333
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# ─── Temporal (workflow orchestration) ─────────────────────────
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=terminology-mapping

# ─── Terminology ───────────────────────────────────────────────
# FI_FHIR_TERMINOLOGY_DB_URL=postgres://fi_fhir:fi_fhir_dev@localhost:5432/fi_fhir?sslmode=disable
# FI_FHIR_TERMINOLOGY_PINS=SNOMED:20240901,LOINC:2.77
# FI_FHIR_TERMINOLOGY_POLICY=warn
# How often serve reconciles the stored status of expired pending autoroutes.
# Set to 0 to disable the sweep. The review queue stays correct either way:
# reads already treat time-expired pending rows as expired.
# FI_FHIR_TERMINOLOGY_AUTOROUTE_SWEEP_INTERVAL=15m
# Webhook notified when high-confidence pending autoroutes await review.
# Unset (the default) disables notifications: no background component and no
# network calls. Dispatch is asynchronous and bounded, so a slow or failing
# webhook can only drop notifications, never delay mapping resolution.
# FI_FHIR_TERMINOLOGY_AUTOROUTE_NOTIFY_WEBHOOK=https://hooks.example.com/terminology-review
# FI_FHIR_TERMINOLOGY_AUTOROUTE_NOTIFY_INTERVAL=15m
# FI_FHIR_TERMINOLOGY_AUTOROUTE_NOTIFY_MIN_CONFIDENCE=0.90
# FI_FHIR_TERMINOLOGY_AUTOROUTE_NOTIFY_TIMEOUT=5s

# ─── MinIO/S3 (terminology ETL) ───────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_USE_SSL=false
# MINIO_BUCKET=terminology

# ─── UMLS API ─────────────────────────────────────────────────
# UMLS_API_KEY=your-umls-api-key

# ─── Observability ─────────────────────────────────────────────
# GET /health (liveness, process-only) and GET /ready (readiness; 503 when a
# dependency reports unhealthy) are always mounted on FI_FHIR_SERVER_PORT.
# There is no toggle for them.
#
# Prometheus /metrics is real and served on a SECOND listener. Metric names
# all start fi_fhir_ (see internal/observability/metrics.go).
# FI_FHIR_METRICS_ENABLED=true
# FI_FHIR_METRICS_PORT=9090
# FI_FHIR_METRICS_ENDPOINT=/metrics
#
# Tracing and structured logging are parsed and validated but NOT
# IMPLEMENTED: no OpenTelemetry exporter and no structured logger consume
# these values in the serve path. Reserved for a future slice.
# FI_FHIR_TRACING_ENABLED=true
# FI_FHIR_TRACING_ENDPOINT=http://localhost:4317
# FI_FHIR_TRACING_SAMPLER=0.1
# FI_FHIR_LOG_LEVEL=debug
# FI_FHIR_LOG_FORMAT=json
#
# FI_FHIR_OBSERVABILITY_MODE=legacy restores pre-Slice-4.3 behaviour (literal
# /health, no /ready, no metrics listener, process-local session fanout and
# notification de-duplication, required FI_FHIR_BATCH_WORKER_ID with no
# derived default). It exists only for an automated negative-control test.
# Do NOT set this in production.
# FI_FHIR_OBSERVABILITY_MODE=legacy

# ─── Secrets resolution ────────────────────────────────────────
# Backend used to resolve ${secret:KEY} references in other settings.
# FI_FHIR_SECRETS_PROVIDER=env         # env, file, vault, aws-ssm, or k8s
