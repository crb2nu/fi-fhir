# fi-fhir Environment Configuration
# Copy this to .env and customize as needed
#
# These variable names match what config.LoadFromEnv() reads and
# what the k3s production deployment injects via fi-fhir-api.yaml.

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Required for persistent event/profile/workflow stores.
# When these are unset, fi-fhir serve falls back to in-memory stores.
FI_FHIR_DATABASE_DRIVER=postgres
FI_FHIR_DATABASE_HOST=localhost
FI_FHIR_DATABASE_PORT=5432
FI_FHIR_DATABASE_NAME=fi_fhir
FI_FHIR_DATABASE_USERNAME=fi_fhir
# FI_FHIR_DATABASE_USER=fi_fhir       # k8s compat alias (used when USERNAME is unset)
FI_FHIR_DATABASE_PASSWORD=fi_fhir_dev
FI_FHIR_DATABASE_SSL_MODE=disable

# ─── Server ────────────────────────────────────────────────────
FI_FHIR_SERVER_HOST=0.0.0.0
FI_FHIR_SERVER_PORT=8081

# ─── Authenticated integration preview ────────────────────────
# Required by `fi-fhir serve`. Use exactly one token source. The direct token
# is suitable only for local development; production should mount a secret file.
FI_FHIR_DEPLOYMENT_TENANT_ID=tenant-a
# Generate locally, for example: openssl rand -hex 32
FI_FHIR_GRAPHQL_BEARER_TOKEN=
# FI_FHIR_GRAPHQL_BEARER_TOKEN_FILE=/var/run/secrets/fi-fhir-graphql/bearer-token
FI_FHIR_GRAPHQL_PRINCIPAL_ID=local-operator
FI_FHIR_GRAPHQL_ROLES=integration:preview
FI_FHIR_GRAPHQL_ALLOWED_ORIGINS=http://localhost:5173
FI_FHIR_INTEGRATION_REGISTRY_PATH=./testdata/golden/integration/adt-http/preview-registry.json

# ─── Workflow ──────────────────────────────────────────────────
# FI_FHIR_WORKFLOW_CONFIG_PATH=./configs/adt-workflow.yaml

# ─── LLM (for AI-powered features) ────────────────────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_DEFAULT_MODEL=llama3.2
# LLM_QUALITY_MODEL=llama3.2

# ─── Qdrant (vector search for terminology) ───────────────────
# QDRANT_URL=http://localhost:6333

# ─── Embedding (for semantic search) ──────────────────────────
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ─── Temporal (workflow orchestration) ─────────────────────────
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=terminology-mapping

# ─── Terminology ───────────────────────────────────────────────
# FI_FHIR_TERMINOLOGY_DB_URL=postgres://fi_fhir:fi_fhir_dev@localhost:5432/fi_fhir?sslmode=disable
# FI_FHIR_TERMINOLOGY_PINS=SNOMED:20240901,LOINC:2.77
# FI_FHIR_TERMINOLOGY_POLICY=warn

# ─── MinIO/S3 (terminology ETL) ───────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_USE_SSL=false
# MINIO_BUCKET=terminology

# ─── UMLS API ─────────────────────────────────────────────────
# UMLS_API_KEY=your-umls-api-key

# ─── Observability ─────────────────────────────────────────────
# FI_FHIR_METRICS_ENABLED=true
# FI_FHIR_METRICS_PORT=9090
# FI_FHIR_LOG_LEVEL=debug
# FI_FHIR_LOG_FORMAT=json
# FI_FHIR_TRACING_ENABLED=true
# FI_FHIR_TRACING_ENDPOINT=http://localhost:4317
