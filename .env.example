# fi-fhir Environment Configuration
# Copy this to .env and customize as needed
#
# These variable names match what config.LoadFromEnv() reads and
# what the k3s production deployment injects via fi-fhir-api.yaml.

# ─── Database (PostgreSQL) ─────────────────────────────────────
# Required for persistent event/profile/workflow stores.
# When these are unset, fi-fhir serve falls back to in-memory stores.
FI_FHIR_DATABASE_DRIVER=postgres
FI_FHIR_DATABASE_HOST=localhost
FI_FHIR_DATABASE_PORT=5432
FI_FHIR_DATABASE_NAME=fi_fhir
FI_FHIR_DATABASE_USERNAME=fi_fhir
# FI_FHIR_DATABASE_USER=fi_fhir       # k8s compat alias (used when USERNAME is unset)
FI_FHIR_DATABASE_PASSWORD=fi_fhir_dev
FI_FHIR_DATABASE_SSL_MODE=disable

# ─── Server ────────────────────────────────────────────────────
FI_FHIR_SERVER_HOST=0.0.0.0
FI_FHIR_SERVER_PORT=8081

# ─── Authenticated integration preview ────────────────────────
# Required by `fi-fhir serve`. Static mode is a local/preview compatibility
# path. Use exactly one token source; the direct token is suitable only for
# local development.
FI_FHIR_DEPLOYMENT_TENANT_ID=tenant-a
FI_FHIR_GRAPHQL_AUTH_MODE=static
# Generate locally, for example: openssl rand -hex 32
FI_FHIR_GRAPHQL_BEARER_TOKEN=
# FI_FHIR_GRAPHQL_BEARER_TOKEN_FILE=/var/run/secrets/fi-fhir-graphql/bearer-token
FI_FHIR_GRAPHQL_PRINCIPAL_ID=local-operator
FI_FHIR_GRAPHQL_ROLES=integration:preview
FI_FHIR_GRAPHQL_ALLOWED_ORIGINS=http://localhost:5173
FI_FHIR_INTEGRATION_REGISTRY_PATH=./testdata/golden/integration/adt-http/preview-registry.json

# OIDC mode verifies each human caller's JWT access token (`typ=at+jwt`)
# through issuer discovery and cached JWKS.
# When enabled, remove every static bearer/principal/roles/trusted-CIDR setting.
# FI_FHIR_GRAPHQL_AUTH_MODE=oidc
# FI_FHIR_GRAPHQL_OIDC_ISSUER_URL=https://identity.example.test
# FI_FHIR_GRAPHQL_OIDC_AUDIENCE=fi-fhir
# FI_FHIR_GRAPHQL_OIDC_TENANT_CLAIM=tenant_id
# FI_FHIR_GRAPHQL_OIDC_ROLES_CLAIM=roles
# FI_FHIR_GRAPHQL_OIDC_SIGNING_ALGS=RS256

# Restart-safe Integration Session workspace. Disabled by default. Enabling it
# requires PostgreSQL. Samples are redacted unless retention is requested
# explicitly; retained raw payloads additionally require a mounted 32-byte key.
# FI_FHIR_INTEGRATION_SESSION_ENABLED=true
# FI_FHIR_INTEGRATION_SESSION_RETENTION_KEY_FILE=/var/run/secrets/fi-fhir-session/aes-256-key

# ─── Authenticated HL7v2 production ingress (optional) ─────────
# Leave AUTH_MODE unset to keep /v1/hl7v2 unmounted. Enabling it requires the
# PostgreSQL variables above. Bearer/HMAC modes require exactly one secret;
# oauth2 instead verifies an allowlisted client through HTTPS discovery/JWKS.
# FI_FHIR_HTTP_INGRESS_AUTH_MODE=bearer       # bearer, hmac-sha256, or oauth2
# FI_FHIR_HTTP_INGRESS_PRINCIPAL_ID=adt-service
# FI_FHIR_HTTP_INGRESS_INTEGRATION_ID=adt-east
# FI_FHIR_HTTP_INGRESS_SECRET=
# FI_FHIR_HTTP_INGRESS_SECRET_FILE=/var/run/secrets/fi-fhir-ingress/credential
# OAuth2 mode requires signed JWT access tokens with typ=at+jwt, sub equal to
# client_id, the deployment tenant, and integration:submit. Remove the static
# principal/secret settings when enabling it.
# FI_FHIR_HTTP_INGRESS_OAUTH_ISSUER_URL=https://identity.example.test
# FI_FHIR_HTTP_INGRESS_OAUTH_AUDIENCE=fi-fhir-ingress
# FI_FHIR_HTTP_INGRESS_OAUTH_TENANT_CLAIM=tenant_id
# FI_FHIR_HTTP_INGRESS_OAUTH_ROLES_CLAIM=roles
# FI_FHIR_HTTP_INGRESS_OAUTH_CLIENT_ID_CLAIM=client_id
# FI_FHIR_HTTP_INGRESS_OAUTH_SIGNING_ALGS=RS256
# FI_FHIR_HTTP_INGRESS_OAUTH_ALLOWED_CLIENT_IDS=svc-adt-east
# FI_FHIR_HTTP_INGRESS_MAX_BODY_BYTES=1048576

# ─── Deployed HL7v2 MLLP listener (optional) ──────────────────
# Leave SOURCE_CONFIG_PATH unset to disable the listener. Production should use
# the mutual-TLS source fixture and file-mounted key/certificate material.
# FI_FHIR_MLLP_SOURCE_CONFIG_PATH=./testdata/golden/integration/adt-mllp/source-revision.json
# FI_FHIR_MLLP_DEFINITION_ID=integration-mllp
# FI_FHIR_MLLP_PRINCIPAL_ID=mllp-listener
# FI_FHIR_MLLP_TLS_CERT_FILE=/var/run/secrets/fi-fhir-mllp/tls.crt
# FI_FHIR_MLLP_TLS_KEY_FILE=/var/run/secrets/fi-fhir-mllp/tls.key
# FI_FHIR_MLLP_TLS_CLIENT_CA_FILE=/var/run/secrets/fi-fhir-mllp/client-ca.crt

# ─── Deployed S3/SFTP batch source (optional) ────────────────
# Leave SOURCE_CONFIG_PATH unset to disable polling. The immutable source file
# selects exactly one provider. PostgreSQL stores raw-free leases/checkpoints.
# FI_FHIR_BATCH_SOURCE_CONFIG_PATH=./testdata/golden/integration/adt-batch-s3/source-revision.json
# FI_FHIR_BATCH_DEFINITION_ID=integration-batch
# FI_FHIR_BATCH_PRINCIPAL_ID=batch-ingest
# FI_FHIR_BATCH_WORKER_ID=fi-fhir-batch-1
# S3 source credentials; production should use file-backed values and TLS.
# FI_FHIR_BATCH_S3_ACCESS_KEY=
# FI_FHIR_BATCH_S3_ACCESS_KEY_FILE=/var/run/secrets/fi-fhir-batch/s3-access-key
# FI_FHIR_BATCH_S3_SECRET_KEY=
# FI_FHIR_BATCH_S3_SECRET_KEY_FILE=/var/run/secrets/fi-fhir-batch/s3-secret-key
# SFTP sources require a pinned known_hosts file and exactly one auth mode.
# FI_FHIR_BATCH_SFTP_KNOWN_HOSTS_FILE=/var/run/secrets/fi-fhir-batch/known_hosts
# FI_FHIR_BATCH_SFTP_PASSWORD=
# FI_FHIR_BATCH_SFTP_PASSWORD_FILE=/var/run/secrets/fi-fhir-batch/sftp-password
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_FILE=/var/run/secrets/fi-fhir-batch/id_ed25519
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_PASSPHRASE=
# FI_FHIR_BATCH_SFTP_PRIVATE_KEY_PASSPHRASE_FILE=/var/run/secrets/fi-fhir-batch/key-passphrase

# ─── Durable Kafka delivery worker (optional) ─────────────────
# Leave WORKER_ENABLED unset/false to preserve pending outbox rows without
# publishing. Kafka credentials are rejected unless TLS is enabled.
# FI_FHIR_DELIVERY_WORKER_ENABLED=true
# FI_FHIR_DELIVERY_WORKER_ID=fi-fhir-local-1
# FI_FHIR_QUEUE_DRIVER=kafka
# FI_FHIR_QUEUE_BROKERS=localhost:9092
# FI_FHIR_QUEUE_CLIENT_ID=fi-fhir-delivery
# FI_FHIR_QUEUE_TLS=false
# FI_FHIR_QUEUE_TLS_ROOT_CA_FILE=/var/run/secrets/fi-fhir-kafka/ca.crt
# FI_FHIR_QUEUE_USERNAME=
# FI_FHIR_QUEUE_PASSWORD=
# FI_FHIR_QUEUE_PASSWORD_FILE=/var/run/secrets/fi-fhir-kafka/password
# FI_FHIR_DELIVERY_LEASE_DURATION=30s
# FI_FHIR_DELIVERY_POLL_INTERVAL=250ms
# FI_FHIR_DELIVERY_PUBLISH_TIMEOUT=10s
# FI_FHIR_DELIVERY_MAX_ATTEMPTS=5
# FI_FHIR_DELIVERY_RETRY_BASE_DELAY=1s
# FI_FHIR_DELIVERY_RETRY_MAX_DELAY=1m
# FI_FHIR_DELIVERY_CIRCUIT_FAILURE_THRESHOLD=3
# FI_FHIR_DELIVERY_CIRCUIT_OPEN_DURATION=30s

# ─── Workflow ──────────────────────────────────────────────────
# FI_FHIR_WORKFLOW_CONFIG_PATH=./configs/adt-workflow.yaml

# ─── LLM (for AI-powered features) ────────────────────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_DEFAULT_MODEL=llama3.2
# LLM_QUALITY_MODEL=llama3.2

# ─── Qdrant (vector search for terminology) ───────────────────
# QDRANT_URL=http://localhost:6333

# ─── Embedding (for semantic search) ──────────────────────────
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ─── Temporal (workflow orchestration) ─────────────────────────
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=terminology-mapping

# ─── Terminology ───────────────────────────────────────────────
# FI_FHIR_TERMINOLOGY_DB_URL=postgres://fi_fhir:fi_fhir_dev@localhost:5432/fi_fhir?sslmode=disable
# FI_FHIR_TERMINOLOGY_PINS=SNOMED:20240901,LOINC:2.77
# FI_FHIR_TERMINOLOGY_POLICY=warn
# How often serve reconciles the stored status of expired pending autoroutes.
# Set to 0 to disable the sweep. The review queue stays correct either way:
# reads already treat time-expired pending rows as expired.
# FI_FHIR_TERMINOLOGY_AUTOROUTE_SWEEP_INTERVAL=15m

# ─── MinIO/S3 (terminology ETL) ───────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_USE_SSL=false
# MINIO_BUCKET=terminology

# ─── UMLS API ─────────────────────────────────────────────────
# UMLS_API_KEY=your-umls-api-key

# ─── Observability ─────────────────────────────────────────────
# FI_FHIR_METRICS_ENABLED=true
# FI_FHIR_METRICS_PORT=9090
# FI_FHIR_LOG_LEVEL=debug
# FI_FHIR_LOG_FORMAT=json
# FI_FHIR_TRACING_ENABLED=true
# FI_FHIR_TRACING_ENDPOINT=http://localhost:4317
