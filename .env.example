# fi-fhir Environment Configuration
# Copy this to .env and customize as needed

# PostgreSQL Event Store (K8s cluster)
# Internal: postgres.fi-fhir.svc.cluster.local:5432
# External: 192.168.50.245:5432 (via LoadBalancer)
FI_FHIR_DATABASE_URL=postgres://fifhir:fifhir-dev-2024%21secure@192.168.50.245:5432/fifhir?sslmode=disable

# Optional: Custom table names
# FI_FHIR_EVENTS_TABLE=events
# FI_FHIR_CHECKPOINTS_TABLE=events_checkpoints

# FHIR Server Configuration (if using subscription features)
# FI_FHIR_SERVER_URL=https://fhir.example.com/r4
# FI_FHIR_AUTH_TOKEN=Bearer xxx

# Workflow Configuration
# FI_FHIR_WORKFLOW_CONFIG=./configs/workflow.yaml

# GraphQL API Server
# FI_FHIR_API_PORT=8080
# FI_FHIR_API_HOST=0.0.0.0
